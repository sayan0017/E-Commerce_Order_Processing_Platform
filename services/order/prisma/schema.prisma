// Prisma schema for the Order & Inventory Service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Customer orders
model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2) @map("total_amount")
  paymentId   String?     @map("payment_id")
  items       OrderItem[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // ── Performance Indexes ──────────────────────────────────────────
  // Fast "my orders" lookup (WHERE user_id = ?)
  @@index([userId])

  // Admin order management (WHERE status = ?)
  @@index([status])

  // Time-range queries for reports
  @@index([createdAt])

  // Composite: user's orders sorted by date
  @@index([userId, createdAt])

  @@map("orders")
}

/// Individual line items within an order
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // ── Performance Indexes ──────────────────────────────────────────
  @@index([orderId])
  @@index([productId])

  @@map("order_items")
}

/// Inventory tracking with reservation support for atomic stock management.
/// The `reserved` field enables a two-phase commit pattern:
///   1. Reserve stock during checkout (stock stays, reserved increases)
///   2. Confirm: decrement both stock and reserved
///   3. Cancel: decrement reserved only
model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  stock     Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Performance Indexes ──────────────────────────────────────────
  @@index([productId])

  @@map("inventory")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
